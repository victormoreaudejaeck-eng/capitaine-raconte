local Strings = {}
local current = EN

function Strings.setLocale(locale: string)
	current = if string.sub(string.lower(locale), 1, 2) == "fr" then FR else EN
end

function Strings.get(key: string, ...: any): string
	local s = current[key] or FR[key] or key
	if select("#", ...) > 0 then
		local args = table.pack(...)
		for i = 1, args.n do
			args[i] = tostring(args[i]) -- tous les gabarits utilisent %s
		end
		return (string.format(s, table.unpack(args, 1, args.n)))
	end
	return s
end

return Strings
